{
  "name": "escola-de-seguranca",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "build": "bun build ./index.html --outdir dist --minify --splitting && node scripts/copiar-public.cjs",
    "build:api": "bun build server/vercel.ts --target=node --format=esm --outfile=api/index.js",
    "colaboradores": "bun scripts/importar-colaboradores.ts",
    "icones": "bun scripts/gerar-icones.ts",
    "importar": "bun scripts/importar-xlsx.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "xlsx": "^0.18.5"
  }
}
